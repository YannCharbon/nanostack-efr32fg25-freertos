--- a/CMakeLists.txt	2026-10-22 17:05:53.237731763 +0200
+++ b/CMakeLists.txt	2026-10-22 17:07:29.046249036 +0200
@@ -18,17 +18,33 @@
 
 set(NANOSTACK_ROOT ${CMAKE_CURRENT_SOURCE_DIR})
 
-include(CheckIncludeFile)
-include(CheckSymbolExists)
-check_include_file(backtrace.h BACKTRACE_FOUND)
-set(CMAKE_REQUIRED_LIBRARIES ${CMAKE_DL_LIBS})
-set(CMAKE_REQUIRED_DEFINITIONS -D_GNU_SOURCE)
-check_symbol_exists(dladdr dlfcn.h LIBDL_FOUND)
-unset(CMAKE_REQUIRED_LIBRARIES)
-unset(CMAKE_REQUIRED_DEFINITIONS)
+# Porting layer (GENERICITY_PLAN.md D18). Default: the Linux port in
+# port/linux. A cross build (e.g. the EFR32 FreeRTOS firmware) sets
+# NANOSTACK_PORT to its own target, which must provide the "common/rand.h",
+# "common/hal_interrupt.h" and "common/utils.h" headers on its include path
+# and implement the porting functions. MbedTLS: if the consumer already
+# defines MbedTLS::mbedtls, MbedTLS::mbedcrypto and MbedTLS::mbedx509 (e.g.
+# INTERFACE/ALIAS targets of its own build), find_package() is skipped.
+if(NOT DEFINED NANOSTACK_PORT)
+    set(NANOSTACK_PORT "nanostack_port_linux" CACHE STRING "Target implementing the Nanostack porting API")
+endif()
+# In-process builds (MAC linked into the same image as the upper stack) must
+# link only one copy of rf_driver_storage.c (D15).
+option(NANOSTACK_RCP_INPROCESS "Drop rcp/mac/rf_driver_storage.c (use nanostack/source/mac/ copy)" OFF)
+
+if(NANOSTACK_PORT STREQUAL "nanostack_port_linux")
+    include(CheckIncludeFile)
+    include(CheckSymbolExists)
+    check_include_file(backtrace.h BACKTRACE_FOUND)
+    set(CMAKE_REQUIRED_LIBRARIES ${CMAKE_DL_LIBS})
+    set(CMAKE_REQUIRED_DEFINITIONS -D_GNU_SOURCE)
+    check_symbol_exists(dladdr dlfcn.h LIBDL_FOUND)
+    unset(CMAKE_REQUIRED_LIBRARIES)
+    unset(CMAKE_REQUIRED_DEFINITIONS)
 
-set(THREADS_PREFER_PTHREAD_FLAG ON)
-find_package(Threads REQUIRED)
+    set(THREADS_PREFER_PTHREAD_FLAG ON)
+    find_package(Threads REQUIRED)
+endif()
 if(NOT TARGET MbedTLS::mbedtls)
     find_package(MbedTLS REQUIRED)
     mark_as_advanced(MbedTLS_DIR)
